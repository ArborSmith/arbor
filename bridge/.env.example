# UE5 Test Editor Launch Configuration
# Copy this file to .env and fill in the paths for your system.
# When set, `npm test` will auto-launch a separate UE5 editor instance.

# Path to UnrealEditor.exe (required to auto-launch)
# UE5_EDITOR_PATH=C:/Program Files/Epic Games/UE_5.5/Engine/Binaries/Win64/UnrealEditor.exe

# Path to your .uproject file (required to auto-launch)
# UE5_PROJECT_PATH=D:/MyGame/MyGame.uproject

# Port for the test editor's Remote Control API (default: 30020)
# Must differ from your dev editor's port (default 30010) so they don't conflict.
# UE5_TEST_PORT=30020

# Run editor headless — no GPU rendering (default: false)
# Set to true for CI or when you don't need the editor UI.
# UE5_HEADLESS=false

# Max time in ms to wait for the editor to start (default: 120000 = 2 minutes)
# UE5_STARTUP_TIMEOUT_MS=120000
